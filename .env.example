# Copy to .env.local — never commit .env.local to GitHub

# ── Provider selection ────────────────────────────────────────────────────────
# VAULT_PROVIDER=github   reads from GitHub API (default)
# VAULT_PROVIDER=local    reads from local sidecar (serve.py)
VAULT_PROVIDER=github

# ── Local mode ───────────────────────────────────────────────────────────────
# Run from vault root:  python braindex/serve.py
# Default port is 4242; override with VAULT_PORT env var on the server side.
VAULT_LOCAL_URL=http://localhost:4242

# ── GitHub mode ───────────────────────────────────────────────────────────────
# Create token at: https://github.com/settings/tokens
# Scopes needed: repo (read private repos)
GITHUB_TOKEN=ghp_your_token_here
GITHUB_OWNER=niclashammarling-dot
GITHUB_REPO=Vaultnix
GITHUB_BRANCH=main

# ── AI queries ────────────────────────────────────────────────────────────────
# Ollama (local, default)
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=qwen2.5:14b

# Anthropic (cloud fallback — not yet wired)
# Get at: https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-your_key_here

# In Vercel dashboard: Settings → Environment Variables
# Add all of the above
